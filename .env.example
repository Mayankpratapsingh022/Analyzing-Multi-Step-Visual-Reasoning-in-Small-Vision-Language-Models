# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.
#
#   cp .env.example .env

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for gated models: LLaVA-NeXT-7B, LLaVA-1.5-13B, Phi-3-Vision.
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ── API models (optional) ─────────────────────────────────────────────────────
# Only needed if running gpt-4o or claude baselines.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Experiment tracking (optional) ───────────────────────────────────────────
# Leave blank to disable W&B logging.
WANDB_API_KEY=
WANDB_PROJECT=small-vlm-reasoning
WANDB_ENTITY=
